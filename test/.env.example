# E2E test configuration (copy to .env to override defaults).
# Loaded automatically by playwright.config.ts via dotenv.
#
# Use these when the default ports clash with other local services.
# IMPORTANT: DEMO_BASE_URL must stay in sync with the provider's registered
# redirect URIs, which docker-compose.yml derives from DEMO_PORT:
#
#   DEMO_PORT=18080 docker compose up -d
#   DEMO_BASE_URL=http://localhost:18080 npx playwright test

# Demo app under test (default http://localhost:8080)
DEMO_BASE_URL=http://localhost:8080

# OIDC provider public origin (default http://localhost:9080)
PROVIDER_BASE_URL=http://localhost:9080

# Directory service (default http://localhost:7080)
DIRECTORY_BASE_URL=http://localhost:7080

# OAuth client must match the provider container (defaults shown).
# When starting compose with custom values, export the same here:
#   PROVIDER_CLIENT_ID=... PROVIDER_CLIENT_SECRET=... docker compose up -d
# PROVIDER_CLIENT_ID=85125d57-a403-4fe2-84d8-62c6db9b6d73
# PROVIDER_CLIENT_SECRET=+XiBpec4OAIeFBSbRdGaAGLNz6ZFfAbq
