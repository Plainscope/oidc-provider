# Test Environment Configuration
# Copy this file to .env and adjust values as needed
#
# Use unmistakably non-production placeholders only (see CONTRIBUTING.md).

# Demo app
DEMO_PORT=8080

# Provider (defaults match docker-compose.yml)
PROVIDER_PORT=9080
PROVIDER_CLIENT_ID=test-client-id
PROVIDER_CLIENT_SECRET=local-dev-secret

# Directory
DIRECTORY_PORT=7080
DIRECTORY_BEARER_TOKEN=local-dev-bearer-token

# Optional overrides for CI / local secrets
# PROVIDER_CLIENT_ID=test-client-id
# PROVIDER_CLIENT_SECRET=local-dev-secret
# DIRECTORY_BEARER_TOKEN=local-dev-bearer-token
